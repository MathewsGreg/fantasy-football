# Copy this file to .env (already gitignored) and fill in real values.
# None of these are API keys you generate — they're your ESPN login session,
# so treat them like a password: never commit them, never paste them
# anywhere but here.

# From the league URL: fantasy.espn.com/football/league?leagueId=XXXXXXX
ESPN_LEAGUE_ID=

# From your browser's dev tools after logging into espn.com/fantasy:
# Application/Storage tab -> Cookies -> https://fantasy.espn.com
# -> copy the Value column for these two rows.
ESPN_S2=
ESPN_SWID=
